  {
    "id": "duty_tyt_mat_0002",
    "exam": "TYT",
    "subject": "Matematik",
    "topic": "Üslü ve köklü ifadeler",
    "minGrade": 9,
    "type": "confusion",
    "title": "√(x²) her zaman x midir?",
    "blocks": [
      {
        "kind": "formula",
        "text": "√(x²) = |x|"
      },
      {
        "kind": "text",
        "text": "Karekökün sonucu negatif olamaz. Bu yüzden x negatifken √(x²) = x yazmak **yanlıştır**."
      },
      {
        "kind": "compare",
        "left": {
          "title": "x = 3",
          "items": [
            "√(3²) = √9 = 3",
            "|3| = 3 olduğu için sonuç x'e eşit"
          ]
        },
        "right": {
          "title": "x = −3",
          "items": [
            "√((−3)²) = √9 = 3",
            "Sonuç 3'tür; x = −3 değildir"
          ]
        }
      },
      {
        "kind": "callout",
        "tone": "warning",
        "text": "(√x)² = x eşitliği ise yalnızca x ≥ 0 için tanımlıdır."
      }
    ],
    "tags": [
      "karekök",
      "mutlak değer"
    ],
    "status": "published",
    "version": 1
  },
