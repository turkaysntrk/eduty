    "subject": "Matematik",
    "topic": "Logaritma",
    "minGrade": 12,
    "tracks": [
      "sayisal",
      "ea"
    ],
    "type": "confusion",
    "title": "log(x²) ile 2·log x aynı mı?",
    "blocks": [
      {
        "kind": "formula",
        "text": "log_a b için: a > 0, a ≠ 1, b > 0"
      },
      {
        "kind": "text",
        "text": "log(x²) ifadesi x ≠ 0 için tanımlıdır; **2·log x** ise yalnızca x > 0 için. Doğru dönüşüm: **log(x²) = 2·log|x|**."
      },
      {
        "kind": "callout",
        "tone": "warning",
        "text": "x = −3 için log(x²) = log 9 tanımlıdır, ama log(−3) tanımsızdır."
      }
    ],
    "tags": [
      "logaritma",
      "tanım kümesi"
    ],
    "status": "published",
    "version": 1
  },
