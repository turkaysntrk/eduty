    "type": "exception",
    "title": "Türevliyse sürekli; peki tersi?",
    "blocks": [
      {
        "kind": "text",
        "text": "Bir noktada **türevli** olan fonksiyon o noktada **süreklidir**. Tersi doğru değildir."
      },
      {
        "kind": "formula",
        "text": "f(x) = |x|"
      },
      {
        "kind": "list",
        "items": [
          "x = 0'da süreklidir.",
          "x = 0'da sol türev −1, sağ türev +1 olduğundan türevsizdir (köşe noktası)."
        ]
      },
      {
        "kind": "callout",
        "tone": "warning",
        "text": "Süreksizse türevsizdir. Sürekli olmak, türevli olmak için yetmez."
      }
    ],
    "tags": [
      "türev",
      "süreklilik"
    ],
    "status": "published",
    "version": 1
